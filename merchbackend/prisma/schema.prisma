generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id          Int                @id @default(autoincrement())
  first_name       String
  last_name        String
  email            String             @unique
  mobile           String             @unique
  dob              DateTime
  password         String
  gender           Gender
  created_at       DateTime
  updated_at       DateTime
  last_login       DateTime
  access_token     String
  otp_expiry       DateTime?
  otp_hashed       String?
  reset_token      String?
  reset_token_expiry DateTime?
  Address          Address[]
  Analytics        Analytics[]
  Cart             Cart[]
  CouponUsage      CouponUsage[]
  Order            Order[]
  Return           Return[]
  ReturnRequest    ReturnRequest[]
  Review           Review[]
  UserNotification UserNotification[]
  Wishlist         Wishlist[]
}

model Address {
  address_id      Int      @id @default(autoincrement())
  user_id         Int
  address_type    String
  street_address  String
  apartment_suite String
  city            String
  state_province  String
  postal_code     String
  is_default      Boolean  @default(true)
  created_at      DateTime
  updated_at      DateTime
  user            User     @relation(fields: [user_id], references: [user_id])
  Order           Order[]  @relation("shipping")
}

model UserNotification {
  notification_id   Int      @id @default(autoincrement())
  user_id           Int
  notification_type String
  title             String
  message           String
  link_url          String
  is_read           Boolean  @default(false)
  created_at        DateTime
  updated_at        DateTime
  user              User     @relation(fields: [user_id], references: [user_id])
}

model Category {
  category_id   Int       @id @default(autoincrement())
  category_name String
  slug          String    @unique
  description   String
  image_url     String
  is_active     Boolean   @default(true)
  created_at    DateTime
  updated_at    DateTime
  Product       Product[]
}

model Product {
  product_id      Int               @id @default(autoincrement())
  product_name    String
  slug            String            @unique
  tag_id          Int
  description     String
  category_id     Int
  base_price      Decimal
  sku             String
  is_active       Boolean           @default(true)
  view_count      Int
  average_rating  Decimal
  total_reviews   Int
  created_at      DateTime
  updated_at      DateTime
  Analytics       Analytics[]
  Cart            Cart[]
  OrderItem       OrderItem[]
  category        Category          @relation(fields: [category_id], references: [category_id])
  tag             Tag               @relation(fields: [tag_id], references: [tag_id])
  ProductDiscount ProductDiscount[]
  ProductImage    ProductImage[]
  ProductVariant  ProductVariant[]
  Review          Review[]
  Wishlist        Wishlist[]
}

model ProductVariant {
  product_variant_id  Int            @id @default(autoincrement())
  product_id          Int
  size                String
  color               String
  material            String
  sku                 String
  price               Decimal
  stock_quantity      Int
  low_stock_threshold Int
  weight              Decimal
  is_available        Boolean        @default(true)
  created_at          DateTime
  updated_at          DateTime
  Cart                Cart[]
  InventoryLog        InventoryLog[]
  OrderItem           OrderItem[]
  product             Product        @relation(fields: [product_id], references: [product_id])
  Wishlist            Wishlist[]
}

model ProductImage {
  image_id      Int      @id @default(autoincrement())
  product_id    Int
  image_url     String
  alt_text      String
  display_order Int
  is_primary    Boolean  @default(false)
  uploaded_at   DateTime
  product       Product  @relation(fields: [product_id], references: [product_id])
}

model ProductDiscount {
  product_discount_id Int      @id @default(autoincrement())
  product_id          Int
  discount_type       String
  discount_value      Decimal
  start_date          DateTime
  end_date            DateTime
  is_active           Boolean  @default(true)
  created_at          DateTime
  product             Product  @relation(fields: [product_id], references: [product_id])
}

model InventoryLog {
  log_id             Int            @id @default(autoincrement())
  product_variant_id Int
  action_type        String
  quantity_change    Int
  quantity_after     Int
  created_at         DateTime
  product_variant    ProductVariant @relation(fields: [product_variant_id], references: [product_variant_id])
}

model Tag {
  tag_id     Int       @id @default(autoincrement())
  tag_name   String
  slug       String    @unique
  created_at DateTime
  Product    Product[]
}

model Cart {
  cart_id            Int            @id @default(autoincrement())
  user_id            Int
  product_id         Int
  product_variant_id Int
  quantity           Int
  added_at           DateTime
  updated_at         DateTime
  product            Product        @relation(fields: [product_id], references: [product_id])
  product_variant    ProductVariant @relation(fields: [product_variant_id], references: [product_variant_id])
  user               User           @relation(fields: [user_id], references: [user_id])
  customization Customization?
}

model Wishlist {
  wishlist_id        Int            @id @default(autoincrement())
  user_id            Int
  product_id         Int
  product_variant_id Int
  product            Product        @relation(fields: [product_id], references: [product_id])
  product_variant    ProductVariant @relation(fields: [product_variant_id], references: [product_variant_id])
  user               User           @relation(fields: [user_id], references: [user_id])
}

model Order {
  order_id           Int                  @id @default(autoincrement())
  order_number       String
  shipping_address   Int
  subtotal           Decimal
  tax_amount         Decimal
  shipping_cost      Decimal
  discount_amount    Decimal
  total_amount       Decimal
  payment_type       String
  order_status       String
  user_id            Int
  created_at         DateTime
  updated_at         DateTime
  CouponUsage        CouponUsage[]
  s_address          Address              @relation("shipping", fields: [shipping_address], references: [address_id])
  user               User                 @relation(fields: [user_id], references: [user_id])
  OrderItem          OrderItem[]
  OrderStatusHistory OrderStatusHistory[]
  Payment            Payment[]
  Return             Return[]
  ReturnRequest      ReturnRequest[]
  Review             Review[]
}

model OrderItem {
  order_item_id      Int            @id @default(autoincrement())
  order_id           Int
  product_id         Int
  product_variant_id Int
  quantity           Int
  unit_price         Decimal
  discount_amount    Decimal
  tax_amount         Decimal
  total_price        Decimal
  created_at         DateTime
  order              Order          @relation(fields: [order_id], references: [order_id])
  product            Product        @relation(fields: [product_id], references: [product_id])
  product_variant    ProductVariant @relation(fields: [product_variant_id], references: [product_variant_id])
  ReturnItem         ReturnItem[]

  Customization Customization[]
}

model OrderStatusHistory {
  status_history_id Int      @id @default(autoincrement())
  order_id          Int
  status            String
  changed_at        DateTime
  order             Order    @relation(fields: [order_id], references: [order_id])
}

model Payment {
  payment_id      Int      @id @default(autoincrement())
  order_id        Int
  payment_method  String
  transaction_id  String
  amount          Decimal
  payment_status  String
  payment_details String
  payment_date    DateTime
  created_at      DateTime
  order           Order    @relation(fields: [order_id], references: [order_id])
}

model Review {
  review_id    Int           @id @default(autoincrement())
  user_id      Int
  product_id   Int
  order_id     Int
  rating       Int
  review_title String
  review_text  String
  created_at   DateTime
  updated_at   DateTime
  order        Order         @relation(fields: [order_id], references: [order_id])
  product      Product       @relation(fields: [product_id], references: [product_id])
  user         User          @relation(fields: [user_id], references: [user_id])
  ReviewImage  ReviewImage[]
}

model ReviewImage {
  review_image_id Int      @id @default(autoincrement())
  review_id       Int
  image_url       String
  updated_at      DateTime
  review          Review   @relation(fields: [review_id], references: [review_id])
}

model Coupon {
  coupon_id           Int           @id @default(autoincrement())
  coupon_code         String        @unique
  description         String
  discount_type       String
  discount_value      Decimal
  min_purchase_amount Int
  max_purchase_amount Int
  usage_limit         Int
  usage_count         Int
  is_active           Boolean       @default(true)
  start_date          DateTime
  end_date            DateTime
  created_at          DateTime
  CouponUsage         CouponUsage[]
}

model CouponUsage {
  usage_id         Int      @id @default(autoincrement())
  coupon_id        Int
  order_id         Int
  user_id          Int
  discount_applied Decimal
  used_at          DateTime
  coupon           Coupon   @relation(fields: [coupon_id], references: [coupon_id])
  order            Order    @relation(fields: [order_id], references: [order_id])
  user             User     @relation(fields: [user_id], references: [user_id])
}

model Admin {
  admin_id     Int      @id @default(autoincrement())
  first_name   String
  last_name    String
  email        String   @unique
  password     String
  phone_number String
  access_token String
  created_at   DateTime
  updated_at   DateTime
}

model Complaint {
  message_id     Int      @id @default(autoincrement())
  sender_id      Int
  sender_type    String
  message        String
  attachment_url String
  created_at     DateTime
}

model Analytics {
  analytics_id Int      @id @default(autoincrement())
  user_id      Int
  product_id   Int
  event_type   String
  page_url     String
  ip_address   String
  event_data   String
  created_at   DateTime
  product      Product  @relation(fields: [product_id], references: [product_id])
  user         User     @relation(fields: [user_id], references: [user_id])
}

model Return {
  return_id     Int          @id @default(autoincrement())
  return_number String       @unique
  user_id       Int
  order_id      Int
  refund_amount Decimal
  reason        String
  return_status String
  requested_at  DateTime
  completed_at  DateTime
  order         Order        @relation(fields: [order_id], references: [order_id])
  user          User         @relation(fields: [user_id], references: [user_id])
  ReturnItem    ReturnItem[]
}

model ReturnRequest {
  return_request_id Int      @id @default(autoincrement())
  return_name       String   @unique
  user_id           Int
  order_id          Int
  reason            String
  return_status     String
  refund_amount     Decimal
  requested_at      DateTime
  approved_at       DateTime
  completed_at      DateTime
  order             Order    @relation(fields: [order_id], references: [order_id])
  user              User     @relation(fields: [user_id], references: [user_id])
}

model ReturnItem {
  return_item_id Int       @id @default(autoincrement())
  return_id      Int
  order_item_id  Int
  quantity       Int
  created_at     DateTime
  order_item     OrderItem @relation(fields: [order_item_id], references: [order_item_id])
  return         Return    @relation(fields: [return_id], references: [return_id])
}

model Customization {
  customization_id Int      @id @default(autoincrement())
  
  order_item_id    Int?     @unique
  order_item       OrderItem? @relation(fields: [order_item_id], references: [order_item_id])

  cart_id          Int?     @unique
  cart             Cart?    @relation(fields: [cart_id], references: [cart_id])

  front_image_url  String?
  back_image_url   String?
  custom_text      String?
  font_style       String?
  text_color       String?
  created_at       DateTime @default(now())
}
enum Gender {
  MALE   @map("Male")
  FEMALE @map("Female")
  OTHER  @map("Other")
}
